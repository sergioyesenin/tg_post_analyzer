# Telegram
TG_API_ID=123456
TG_API_HASH=your_api_hash_here
TG_PHONE=+10000000000

# App
TZ=UTC
LOG_LEVEL=INFO

# Database (пример для docker-compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tg_analytics

# Linking
LINKING_PIPELINE_VERSION=v2-evidence-first
LINKING_TOP_K=50
LINKING_EMBED_ENABLED=true
LINKING_EMBED_MODEL=nomic-embed-text
LINKING_EMBED_TIMEOUT_SEC=20
LINKING_EMBED_MIN_SIM=0.85
LINKING_PREFILTER_MULTIPLIER=8
LINKING_SAME_EVENT_ENTITY_OVERLAP_MIN=0.2
LINKING_RELATED_TIME_WINDOW_HOURS=168
LINKING_MAX_TEXT_CHARS=5000
NO_LLM_SAME_EVENT_MIN_SIM=0.915
NO_LLM_SAME_EVENT_MAX_HOURS=10

# Optional LLM-backed reporting/titles (outside linking)
LINKER_LLM_MODEL=ollama/llama3:8b-instruct-q4_K_M
LINKER_LLM_BASE_URL=http://localhost:11434
LINKER_LLM_API_KEY=
DISCUSSION_FALLBACK_ID_WINDOW=2
DISCUSSION_FALLBACK_MAX_SECONDS=10

# Auth
AUTH_JWT_SECRET=change-me-in-prod
AUTH_JWT_ALG=HS256
AUTH_ACCESS_TTL_MINUTES=60
AUTH_PROVIDER_MODE=local
